FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM node:24-alpine AS dependencies
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=development PORT=8080 NOTESGYM_DATA_DIR=/data
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY server.js package.json ./
COPY integration ./integration
COPY src/lib/analytics ./src/lib/analytics
COPY scripts/chatgpt-preflight.mjs scripts/chatgpt-oauth-backup.mjs scripts/chatgpt-oauth-invalidate.mjs scripts/chatgpt-dev-keys.mjs ./scripts/
RUN mkdir -p /data/oauth && chown -R node:node /data && chmod 700 /data /data/oauth
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
