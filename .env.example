# Copy to .env.mcp.local (ignored by Git). Local test data ONLY.
NODE_ENV=development
PORT=8080
NOTESGYM_DATA_DIR=./.notesgym-test-data/manual-mcp
NOTESGYM_MCP_ENABLED=false
NOTESGYM_PUBLIC_URL=http://localhost:8080
NOTESGYM_TRUST_PROXY=false
NOTESGYM_SECURE_COOKIES=false
# Supply a disposable test account through the environment; never real credentials.
NOTESGYM_USERS=
# Public client identifiers and EXACT callback URLs. Replace for ChatGPT testing.
NOTESGYM_OAUTH_CLIENTS='[{"client_id":"notesgym-local","redirect_uris":["http://localhost:8090/callback"]}]'
# Generate keys locally with: node scripts/chatgpt-dev-keys.mjs
# Never commit the generated output, or send it to ChatGPT.
NOTESGYM_OAUTH_COOKIE_KEYS=
NOTESGYM_OAUTH_JWKS=
