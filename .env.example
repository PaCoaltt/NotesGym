# Copy to .env (ignored by Git). Docker Compose forwards these web settings.
# Local HTTP; for Cloudflare Tunnel set https://notesgym.lupachat.ch instead.
NOTESGYM_PUBLIC_URL=http://localhost:8080
# Optional: trust ONLY the direct proxy IP/CIDR as seen by the app container.
# Not required for HTTPS login when NOTESGYM_PUBLIC_URL is explicitly configured.
NOTESGYM_TRUST_PROXY=false
NOTESGYM_TRUSTED_PROXY_IPS=
# HTTPS public URLs always produce Secure session cookies.
NOTESGYM_SECURE_COOKIES=false
# Existing NOTESGYM_DATA_DIR and NOTESGYM_USERS settings must be preserved.
# A native Node process must receive these variables from its environment
# (or a supported Node --env-file option); it does not load .env automatically.
