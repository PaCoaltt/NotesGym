{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "notesgym": {
      "type": "streamable-http",
      "url": "http://localhost:8080/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "notesgym-local",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["notes:read"]
          }
        }
      }
    }
  }
}
